{
  "name": "netvelox",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm start\"",
    "dev:api": "npm --prefix server run dev",
    "companion": "node companion/src/index.js",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "build:api": "npm --prefix server run build",
    "assets": "node scripts/generate-assets.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "echarts": "^6.1.0",
    "flag-icons": "^7.6.0",
    "jspdf": "^4.2.1",
    "ngx-echarts": "^22.0.0",
    "ngx-gauge": "^14.0.0",
    "rxjs": "~7.8.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^10.0.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
